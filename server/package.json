{
  "name": "@jdweb/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "for f in src/*.test.ts; do tsx --test \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@noble/hashes": "^2.4.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
