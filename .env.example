# Minimal boot / process config. App settings (JD URL, library paths, mover)
# live in SQLite and are edited in Settings after first run.

# HTTP listen address
JDWEB2_HOST=127.0.0.1
JDWEB2_PORT=8787

# Public URL path prefix (no trailing slash). Recommended: /jdweb.
# Synced into Settings on boot when set (Compose). Leave empty to edit in UI.
# See docs/Reverse-proxy.md — no UI rebuild required.
JDWEB2_BASE_PATH=

# SQLite database path
JDWEB2_DB_PATH=./data/jdweb.sqlite

# Secrets: set explicitly, or let jdweb create data/secrets.env (mode 600) on first boot.
# JDWEB2_SESSION_SECRET=
# JDWEB2_DATA_KEY=
# JDWEB2_DATA_KEY_PREVIOUS=

# Refuse default/derived secrets (also enabled when NODE_ENV=production)
# JDWEB2_STRICT_SECRETS=1

# Optional one-shot first admin when the users table is empty (Docker)
# JDWEB2_USER=admin
# JDWEB2_PASSWORD=changeme

# Optional seed for Settings / app_settings (preferred: edit in the UI after first boot).
# Used only to seed SQLite the first time the table is empty.
# Defaults (no env): ~/medias/jdownloader/staging and ~/medias/jdownloader/library/…
# JD_API_URL=http://127.0.0.1:3128
# JDWEB2_STAGING_DIR=/home/YOU/medias/jdownloader/staging
# JDWEB2_MOVIES_DIR=/home/YOU/medias/jdownloader/library/movies
# JDWEB2_SHOWS_DIR=/home/YOU/medias/jdownloader/library/shows
# JDWEB2_OTHER_DIR=/home/YOU/medias/jdownloader/library/other
# JDWEB2_MOVER_INTERVAL_MS=15000
# JDWEB2_WEBHOOK_URLS=

# Live update poll interval (ms) when SSE clients are connected
# JDWEB2_EVENTS_INTERVAL_MS=2000

# Optional OIDC (Authelia / Authentik / Keycloak)
# JDWEB2_OIDC_ISSUER=https://auth.example.com/application/o/jdweb
# JDWEB2_OIDC_CLIENT_ID=
# JDWEB2_OIDC_CLIENT_SECRET=
# JDWEB2_OIDC_REDIRECT_URI=https://example.com/jdweb/api/auth/oidc/callback
# JDWEB2_OIDC_USERNAME_CLAIM=preferred_username
# JDWEB2_OIDC_AUTO_PROVISION=false

# Vite dev only
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8787
