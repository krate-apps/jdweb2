# HTTP listen address for the jdweb server
# Use 127.0.0.1 for local-only. Use 0.0.0.0 to accept connections from other machines.
JDWEB_HOST=127.0.0.1
JDWEB_PORT=8787

# Public URL path prefix (no trailing slash). Examples:
#   empty          → http://localhost:8787/
#   /jdweb         → http://user.example.com/jdweb
#   /alice/jdweb   → http://example.com/alice/jdweb
JDWEB_BASE_PATH=

# Session signing secret (always required)
JDWEB_SESSION_SECRET=replace-with-a-long-random-string

# SQLite database for jdweb users and encrypted hoster accounts
JDWEB_DB_PATH=./data/jdweb.sqlite

# 32-byte AES key as 64 hex chars for hoster password encryption (required in production)
# Generate e.g.: openssl rand -hex 32
JDWEB_DATA_KEY=
# Previous key during rotation — set while switching JDWEB_DATA_KEY, remove after a clean restart
# JDWEB_DATA_KEY_PREVIOUS=

# Optional one-shot seed of the first admin when the users table is empty (Docker)
# Login afterwards uses the SQLite user (argon2id), not these env values.
JDWEB_USER=admin
JDWEB_PASSWORD=changeme

# JDownloader local HTTP API (server-side only)
JD_API_URL=http://127.0.0.1:3128

# Staging area where JDownloader downloads and extracts
JDWEB_STAGING_DIR=./data/staging

# Library folders the mover writes into
JDWEB_MOVIES_DIR=./data/library/movies
JDWEB_SHOWS_DIR=./data/library/shows
JDWEB_OTHER_DIR=./data/library/other

# Mover poll interval in milliseconds (0 disables the mover)
JDWEB_MOVER_INTERVAL_MS=15000

# Vite dev only — leave empty in production (server serves the SPA)
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8787
