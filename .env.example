# Minimal boot / process config. App settings (JD URL, library paths, mover)
# live in SQLite and are edited in Settings after first run.

# HTTP listen address
JDWEB_HOST=127.0.0.1
JDWEB_PORT=8787

# Public URL path prefix (no trailing slash). Rebuild the UI after changing.
# See docs/Reverse-proxy.md
JDWEB_BASE_PATH=

# SQLite database path
JDWEB_DB_PATH=./data/jdweb.sqlite

# Secrets: set explicitly, or let jdweb create data/secrets.env (mode 600) on first boot.
# JDWEB_SESSION_SECRET=
# JDWEB_DATA_KEY=
# JDWEB_DATA_KEY_PREVIOUS=

# Refuse default/derived secrets (also enabled when NODE_ENV=production)
# JDWEB_STRICT_SECRETS=1

# Optional one-shot first admin when the users table is empty (Docker)
# JDWEB_USER=admin
# JDWEB_PASSWORD=changeme

# Legacy overrides — preferred path is Settings UI / app_settings table.
# Used only to seed SQLite the first time (or if you still export them).
# JD_API_URL=http://127.0.0.1:3128
# JDWEB_STAGING_DIR=./data/staging
# JDWEB_MOVIES_DIR=./data/library/movies
# JDWEB_SHOWS_DIR=./data/library/shows
# JDWEB_OTHER_DIR=./data/library/other
# JDWEB_MOVER_INTERVAL_MS=15000
# JDWEB_WEBHOOK_URLS=

# Vite dev only
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8787
