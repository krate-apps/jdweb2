{
  "name": "jdweb",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted web companion for JDownloader 2",
  "scripts": {
    "dev": "pnpm --parallel --filter ./server --filter ./web dev",
    "dev:server": "pnpm --filter ./server dev",
    "dev:web": "pnpm --filter ./web dev",
    "build": "pnpm --filter ./web build && pnpm --filter ./server build",
    "start": "pnpm --filter ./server start",
    "rebuild": "pnpm build && pnpm --filter ./server start",
    "typecheck": "pnpm --filter ./web typecheck && pnpm --filter ./server typecheck",
    "wiki:publish": "./scripts/publish-wiki.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.7.0"
}
